server:
  port: ${PRODUCT_PORT:9090}
app:
  roles:
    ADMIN: "00000000-0000-0000-0000-000000000001"
    USER: "00000000-0000-0000-0000-000000000002"
  user:
    default:
      role-id: ${app.roles.USER}
      active: true
    admin-creation:
      role-id: ${app.roles.ADMIN}
      active: false
spring:
  cloud:
    gateway:
      enabled: false
  application:
    name: product-service
  datasource:
    url: ${SPRING_DATASOURCE_URL:jdbc:postgresql://db:${POSTGRES_PORT}/${POSTGRES_DB}}
    username: ${SPRING_DATASOURCE_USERNAME:product}
    password: ${SPRING_DATASOURCE_PASSWORD:product123}
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: none
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
  rabbitmq:
    host: ${SPRING_RABBITMQ_HOST:rabbitmq}
    port: ${SPRING_RABBITMQ_PORT:5672}
    username: ${SPRING_RABBITMQ_USERNAME:guest}
    password: ${SPRING_RABBITMQ_PASSWORD:guest}
  security:
    oauth2:
      resourceserver:
        jwt: # Configuración estándar para Spring Security Resource Server
          # 🛡️ IMPORTANTE: Genera una clave Base64 aleatoria y fuerte (ej: openssl rand -base64 32)
          secret-key: ${JWT_SECRET:YOUR_SECURE_RANDOM_BASE64_SECRET_HERE_44_CHARS_OR_MORE}
  jwt: # Tu sección personalizada para JwtUtil (si es diferente a la de Spring Security)
    # 🛡️ IMPORTANTE: Esta clave debe ser la misma que la de 'secret-key' de Spring Security
    secret: ${JWT_SECRET:YOUR_SECURE_RANDOM_BASE64_SECRET_HERE_44_CHARS_OR_MORE}
    expiration: ${JWT_EXPIRATION:3600000} # Por defecto 1 hora en ms
  eureka:
    client:
      service-url:
        defaultZone: ${DISCOVERY_SERVICE_EUREKA:http://discovery-service:8761/eureka/}
    instance:
      prefer-ip-address: true
      instance-id: ${spring.application.name}:${random.value}
  management:
    endpoints:
      web:
        exposure:
          include: "*"
    tracing:
      sampling:
        probability: 1.0
      zipkin:
        tracing:
          endpoint: ${MANAGEMENT_ZIPKIN_TRACING_ENDPOINT:http://localhost:9411/api/v2/spans}
  logging:
    level:
      com.celotts: DEBUG
      org.springframework.web: INFO
      org.hibernate.SQL: DEBUG
      org.hibernate.type.descriptor.sql.BasicBinder: TRACE
