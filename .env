# Environment variables for local development with Podman/Docker Compose
# This file should NOT be committed to version control.

# PostgreSQL Credentials
POSTGRES_DB=pos_db
POSTGRES_USER=product
POSTGRES_PASSWORD=product123

# Application Port
APP_PORT=9090

# JWT Secrets -
# Generate a new, long, random Base64 string for your secret.
JWT_SECRET="======================CelottsJWTSecretDefaultDevKey==========================="
#JWT_EXPIRATION=3600000
JWT_EXPIRATION=90000
# Default Admin User Credentials (if needed by BootstrapService)
ADMIN_EMAIL=admin@posapi.com
ADMIN_PASSWORD=SuperSecretPassword123!
ADMIN_FULL_NAME=Admin User

# AÑADIDO: Configuración de Ollama para Spring AI
SPRING_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
